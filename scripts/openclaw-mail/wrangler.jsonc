{
  "name": "openclaw-mail-inbound",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{"pattern":"ai-ing.org/api/bot-mail*","zone_name":"ai-ing.org"}],
